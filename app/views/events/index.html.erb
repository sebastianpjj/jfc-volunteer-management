<% content_for :javascript do %>
  <!-- Ultra-aggressive cache busting with timestamp and random values -->
  <script type="module">
    // Cache busting import with multiple strategies
    const deploymentVersion = '<%= Rails.application.config.assets.version || "default" %>';
    const timestamp = Date.now();
    const random = Math.random().toString(36).substring(7);
    const cacheBuster = `${deploymentVersion}_${timestamp}_${random}`;
    
    console.log('🚀 Loading react_components with ultra cache buster:', cacheBuster);

    // Try multiple paths to bypass cache
    const importPaths = [
      `/assets/react_components.js?v=${cacheBuster}&bust=true`,
      `/assets/react_components.js?cache_bust=${cacheBuster}`,
      `/assets/react_components.js?version=${deploymentVersion}&t=${timestamp}&r=${random}`
    ];

    async function loadWithFallback() {
      for (let i = 0; i < importPaths.length; i++) {
        try {
          console.log(`🔄 Trying import path ${i + 1}:`, importPaths[i]);
          const module = await import(importPaths[i]);
          console.log('✅ react_components loaded successfully with path:', importPaths[i]);
          
          if (module.initializeReactComponents) {
            module.initializeReactComponents();
            console.log('🎯 React components initialized');
          }
          return; // Success, exit function
        } catch (error) {
          console.warn(`❌ Failed to load with path ${i + 1}:`, error);
          if (i === importPaths.length - 1) {
            console.error('❌ All import paths failed');
          }
        }
      }
    }

    loadWithFallback();
  </script>
<% end %><div id="events-list-react"></div>
