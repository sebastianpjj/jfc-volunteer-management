<% content_for :title, @event.name %>

<% content_for :javascript do %>
  <!-- Force cache busting with aggressive cache-busting headers -->
  <script type="module">
    // Cache busting import with timestamp
    const cacheBuster = '<%= Rails.application.config.assets.version || Time.current.to_i %>';
    console.log('🚀 Loading react_components with cache buster:', cacheBuster);

    import('/assets/react_components.js?v=' + cacheBuster + '&t=' + Date.now())
      .then((module) => {
        console.log('✅ react_components loaded successfully with cache busting');
        // Initialize the React components
        if (module.initializeReactComponents) {
          module.initializeReactComponents();
          console.log('🎯 React components initialized');
        }
      })
      .catch(error => {
        console.error('❌ Failed to load react_components:', error);
        // Fallback to regular import
        return import('/assets/react_components.js').then((module) => {
          if (module.initializeReactComponents) {
            module.initializeReactComponents();
          }
        });
      });
  </script>
<% end %><div id="event-detail-react" data-event-id="<%= @event.id %>"></div>
