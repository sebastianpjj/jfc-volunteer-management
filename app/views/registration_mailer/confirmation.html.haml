                                                          %td{style: "padding: 8px 12px; border: 1px solid #dee2e6;"}= @registration.name
                                                        %tr
                                                          %td{style: "padding: 8px 12px; background-color: #f8f9fa; border: 1px solid #dee2e6; font-weight: bold;"} E-Mail:
                                                          %td{style: "padding: 8px 12px; border: 1px solid #dee2e6;"}= @registration.email
                                                        - if @registration.phone.present?
