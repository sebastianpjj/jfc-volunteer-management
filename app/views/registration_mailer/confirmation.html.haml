                                                        %tr
                                                          %td{style: "padding: 8px 12px; background-color: #f8f9fa; border: 1px solid #dee2e6; font-weight: bold;"} Dienst:
                                                          %td{style: "padding: 8px 12px; border: 1px solid #dee2e6;"}= @shift.name
                                                        %tr
                                                          %td{style: "padding: 8px 12px; background-color: #f8f9fa; border: 1px solid #dee2e6; font-weight: bold;"} Bereich:
